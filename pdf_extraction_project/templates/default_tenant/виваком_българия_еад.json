{
    "vendor": "Виваком България ЕАД",
    "fields": {
        "invoice_number": {
            "type": "regex",
            "patterns": [
                "INVOICE\\s+/\\s+ФАКТУРА\\s+№:\\s*(\\d{10})",
                "ФАКТУРА\\s+№:\\s*(\\d{10})"
            ]
        },
        "invoice_date": {
            "type": "regex",
            "patterns": [
                "Дата\\s+на\\s+фактура\\s+(\\d{2}\\.\\d{2}\\.\\d{4})"
            ],
            "post_process": "to_date"
        },
        "total_amount_eur": {
            "type": "regex",
            "pattern": "Total\\s+amount\\s+to\\s+be\\s+paid\\s+EUR[\\s\\r\\n]+(\\d{1,3}(?:[.,]\\d{3})*[.,]\\d{2})",
            "post_process": "to_decimal_eu"
        }
    }
}